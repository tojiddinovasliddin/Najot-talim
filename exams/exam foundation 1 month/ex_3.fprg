<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ex_3"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-30 03:56:50 PM"/>
        <attribute name="created" value="VXNlcjtXSU4tVDcwQkVKMDRSTjc7MjAyNi0wNS0zMDswMzo0NDoxMSBQTTsyNjg0"/>
        <attribute name="edited" value="VXNlcjtXSU4tVDcwQkVKMDRSTjc7MjAyNi0wNS0zMDswMzo1Njo1MCBQTTsxOzI3OTg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, ctn" type="Integer" array="False" size=""/>
            <output expression="&quot;Sonni kiriting: &quot;" newline="True"/>
            <input variable="a"/>
            <assign variable="ctn" expression="0"/>
            <while expression="a&gt;0">
                <assign variable="b" expression="a % 10"/>
                <if expression="b % 2 ==0">
                    <then>
                        <output expression="b" newline="True"/>
                        <assign variable="ctn" expression="ctn+1"/>
                        <assign variable="a" expression="a/10"/>
                    </then>
                    <else/>
                </if>
            </while>
            <output expression="&quot;Count&quot; &amp;ctn" newline="True"/>
        </body>
    </function>
</flowgorithm>
